rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School Settings
    match /settings/{docId} {
      allow read, write: if true;
    }
    
    // Students Collection
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Teachers Collection (Database Guru)
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Subjects Collection (Database Mata Pelajaran)
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Attendance Collection
    match /attendance/{monthKey} {
      allow read, write: if true;
    }

    // Homeroom Monthly Reports Collection
    match /homeroom_reports/{monthKey} {
      allow read, write: if true;
    }

    // Teacher Attendance and Classroom Agenda Collection
    match /teacher_agenda/{monthKey} {
      allow read, write: if true;
    }

    // WhatsApp Transmission Audit Logs Collection
    match /whatsapp_logs/{logId} {
      allow read, write: if true;
    }
  }
}
